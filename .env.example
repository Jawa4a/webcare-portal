POSTGRES_DB=webcare
POSTGRES_USER=webcare
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000
SESSION_COOKIE_SECURE=false
# Никогда не включайте вне изолированного тестового контура.
AUDIT_ALLOW_PRIVATE_ADDRESSES=false
AUDIT_MAX_RUNTIME=60s
AUDIT_CONNECT_TIMEOUT=5s
AUDIT_REQUEST_TIMEOUT=10s
AUDIT_MAX_RESPONSE_BYTES=2097152
AUDIT_MAX_REDIRECTS=5

# Локальные учётные записи. Перед публикацией обязательно замените пароли.
BOOTSTRAP_ADMIN_EMAIL=admin@webcare.local
BOOTSTRAP_ADMIN_PASSWORD=change-admin-password
BOOTSTRAP_SPECIALIST_EMAIL=specialist@webcare.local
BOOTSTRAP_SPECIALIST_PASSWORD=change-specialist-password
BOOTSTRAP_VIEWER_EMAIL=viewer@webcare.local
BOOTSTRAP_VIEWER_PASSWORD=change-viewer-password
