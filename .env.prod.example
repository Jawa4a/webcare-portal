# Public domain with an A/AAAA record pointing to the server.
APP_DOMAIN=
# Email used for ACME certificate notifications.
ACME_EMAIL=

POSTGRES_DB=webcare
POSTGRES_USER=webcare
POSTGRES_PASSWORD=

AUDIT_MAX_RUNTIME=60s
AUDIT_CONNECT_TIMEOUT=5s
AUDIT_REQUEST_TIMEOUT=10s
AUDIT_MAX_RESPONSE_BYTES=2097152
AUDIT_MAX_REDIRECTS=5

# Публичные учётные данные кнопок «Демо-роли» закреплены в compose.prod.yaml.
